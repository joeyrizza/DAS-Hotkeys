
if($MONTAGE1.Bid > $MONTAGE1.AvgCost) {
    $MONTAGE1.CXL ALLSYMB;

    $qty=$MONTAGE1.Pos*0.5;

    $MONTAGE1.ROUTE=LIMIT;
    $MONTAGE1.Price=$MONTAGE1.Ask;
    $MONTAGE1.Share=$qty;
    $MONTAGE1.SELL=Send;

    $MONTAGE1.ROUTE=STOP;
    $MONTAGE1.StopType=LimitP;
    $MONTAGE1.StopPrice=$MONTAGE1.AvgCost;
    $MONTAGE1.Price=$MONTAGE1.AvgCost;
    $MONTAGE1.Share=$MONTAGE1.Pos-$qty;
    $MONTAGE1.SELL=Send;
} else {
    Speak "Trade is not profitable, exiting on bid";

    $MONTAGE1.CXL ALLSYMB;

    $MONTAGE1.Price=$MONTAGE1.Bid-0.10;
    $MONTAGE1.ROUTE=LIMIT;
    $MONTAGE1.Share=$MONTAGE1.Pos;
    $MONTAGE1.SELL=Send;
}
