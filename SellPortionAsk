if($M.Bid > $M.AvgCost) {
    $M.CXL ALLSYMB;

    $qty=$M.Pos*0.5;

    $M.ROUTE=LIMIT;
    $M.Price=$M.Ask;
    $M.Share=$qty;
    $M.SELL=Send;

    $M.ROUTE=STOP;
    $M.StopType=LimitP;
    $M.StopPrice=$M.AvgCost;
    $M.Price=$M.AvgCost;
    $M.Share=$M.Pos-$qty;
    $M.SELL=Send;
} else {
    Speak "Trade is not profitable, exiting on bid";

    $M.CXL ALLSYMB;

    $M.Price=$M.Bid-0.10;
    $M.ROUTE=LIMIT;
    $M.Share=$M.Pos;
    $M.SELL=Send;
}