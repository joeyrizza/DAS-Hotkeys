
//Read the position once: Pos can change as soon as the partial fills
$pos=$MONTAGE1.Pos;
if($pos <= 0){ return; }

$Route="ARCA1L";

if($MONTAGE1.Bid > $MONTAGE1.AvgCost) {
    $MONTAGE1.CXL ALLSYMB;

    $qty=$pos*0.5;

    $MONTAGE1.ROUTE=$Route;
    $MONTAGE1.Price=$MONTAGE1.Ask;
    $MONTAGE1.Share=$qty;
    $MONTAGE1.SELL=Send;

    $MONTAGE1.ROUTE=STOP;
    $MONTAGE1.StopType=LimitP;
    $MONTAGE1.StopPrice=$MONTAGE1.AvgCost;
    $MONTAGE1.Price=$MONTAGE1.AvgCost-0.05;
    $MONTAGE1.Share=$pos-$qty;
    $MONTAGE1.SELL=Send;
} else {
    Speak "Trade is not profitable, exiting on bid";

    $MONTAGE1.CXL ALLSYMB;

    $MONTAGE1.Price=$MONTAGE1.Bid-0.10;
    $MONTAGE1.ROUTE=$Route;
    $MONTAGE1.Share=$pos;
    $MONTAGE1.SELL=Send;
}
