{
  "description": "Test scripts, buttons and arming on real setups. Expected values are what DAS showed when the fixture was exported.",
  "fixture": "JAGX_20261124_1359",
  "tests": [
    {
      "name": "JAGX 13:59: buttons match DAS",
      "run": ["RunTests_Dispatch", "RunTests_ChartUpdate"],
      "expect": {
        "vars": { "DIPREASON": "Dip Trade OK", "ST_RVOL10": 0.99 },
        "buttons": {
          "LADDER1.btn_dip": { "text": "DIP: OK", "bkcolor": "green" },
          "LADDER1.btn_curl": { "text": "CURL: RVOL < 1.0", "bkcolor": "orange" },
          "LADDER1.btn_pattern": { "text": "No Pattern" },
          "CHART1.btn_candle_type": { "text": "Hanging Man / BEARISH" },
          "CHART1.btn_rvol": { "text": "RVOL: 373.4x", "bkcolor": "green" },
          "CHART1.btn_vwap": { "text": "Above VWAP", "bkcolor": "green" },
          "CHART1.btn_vol": { "text": "Volume: 10.1M", "bkcolor": "green" },
          "CHART1.btn_gap": { "text": "Gap: 92%", "bkcolor": "green" },
          "CHART1.btn_spread": { "text": "Spread: $0.12", "bkcolor": "red" }
        }
      }
    },
    {
      "name": "JAGX 13:59: candles 2.7% of price and 0.8x the 8 before arm (DAS blocked it under the old $0.30 limit, showing Rng4: $0.32 Rng10: $0.39 in red)",
      "run": ["RunTests_Dispatch", "RunTests_ChartUpdate", "Setup Armed"],
      "expect": {
        "vars": { "SETUPARMED": 1 },
        "speech": ["Stock is expensive", "Stock has a wide spread.", "Price action has not yet confirmed a reversal.", "Setup armed."],
        "buttons": {
          "CHART1.btn_arm": { "text": "Disarm Setup" },
          "CHART1.btn_range": { "text": "Rng4: $0.32 (2.7%) Spike: 0.8x", "bkcolor": "color(211,211,211)" }
        }
      }
    },
    {
      "name": "RVOL: no data shows 0x in orange",
      "run": ["TestRVOL"],
      "quote": { "RVOL": 0, "Volume": 0 },
      "expect": { "buttons": { "CHART1.btn_rvol": { "text": "RVOL: 0x", "bkcolor": "orange" } } }
    },
    {
      "name": "MACD: both 0 before DAS has enough bars shows No Data in gray",
      "run": ["TestMACD"],
      "bar0": { "studies": { "StudyMACD": "MACD:0.000000, Signal:0.000000\n" } },
      "expect": {
        "vars": { "MACDREADY": 0 },
        "buttons": { "CHART1.btn_macd": { "text": "MACD: No Data", "bkcolor": "color(211,211,211)" } }
      }
    },
    {
      "name": "MACD: signal line still 0 (NRSN 08:27) shows No Data, not Pos",
      "run": ["TestMACD"],
      "bar0": { "studies": { "StudyMACD": "MACD:0.311107, Signal:0.000000\n" } },
      "expect": {
        "vars": { "MACDREADY": 0, "MACD": 0.311, "SIGNAL": 0 },
        "buttons": { "CHART1.btn_macd": { "text": "MACD: No Data", "bkcolor": "color(211,211,211)" } }
      }
    },
    {
      "name": "MACD: above the signal line shows Pos in green",
      "run": ["TestMACD"],
      "bar0": { "studies": { "StudyMACD": "MACD:0.210379, Signal:0.105000\n" } },
      "expect": {
        "vars": { "MACDREADY": 1, "MACD": 0.21, "SIGNAL": 0.105 },
        "buttons": { "CHART1.btn_macd": { "text": "MACD Pos", "bkcolor": "green" } }
      }
    },
    {
      "name": "MACD: below the signal line shows Neg in red",
      "run": ["TestMACD"],
      "bar0": { "studies": { "StudyMACD": "MACD:-0.036075, Signal:-0.032498\n" } },
      "expect": {
        "vars": { "MACDREADY": 1 },
        "buttons": { "CHART1.btn_macd": { "text": "MACD Neg", "bkcolor": "red" } }
      }
    },
    {
      "name": "MACD: equal to 3 decimals shows Flat in gray (Setup Armed doesn't warn either)",
      "run": ["TestMACD"],
      "bar0": { "studies": { "StudyMACD": "MACD:0.004100, Signal:0.003900\n" } },
      "expect": {
        "vars": { "MACDREADY": 1, "MACD": 0.004, "SIGNAL": 0.004 },
        "buttons": { "CHART1.btn_macd": { "text": "MACD Flat", "bkcolor": "color(211,211,211)" } }
      }
    },
    {
      "name": "EMA trend: NRSN 08:05, chart started 08:02, not 3 bars back yet: NO DATA in gray",
      "fixture": "NRSN_20261125_1502",
      "until": "08:05",
      "run": ["TestEMATrendState"],
      "expect": {
        "vars": { "EMA_TREND_STATE": 0 },
        "buttons": { "CHART1.btn_ematrend": { "text": "EMA: NO DATA", "bkcolor": "color(211,211,211)" } }
      }
    },
    {
      "name": "EMA trend: NRSN 08:06 uses 3 bars back for both EMAs: UPTREND (was SIDEWAYS)",
      "fixture": "NRSN_20261125_1502",
      "until": "08:06",
      "run": ["TestEMATrendState"],
      "expect": {
        "vars": { "EMA_TREND_STATE": 1, "EMA9_BASE": 1.36, "EMA20_BASE": 1.36 },
        "buttons": { "CHART1.btn_ematrend": { "text": "EMA: UPTREND", "bkcolor": "green" } }
      }
    },
    {
      "name": "EMA trend: NRSN 08:09 uses 5 bars back for the 20 EMA (10 back is before the chart)",
      "fixture": "NRSN_20261125_1502",
      "until": "08:09",
      "run": ["TestEMATrendState"],
      "expect": {
        "vars": { "EMA_TREND_STATE": 1, "EMA9_BASE": 1.346, "EMA20_BASE": 1.353 },
        "buttons": { "CHART1.btn_ematrend": { "text": "EMA: UPTREND", "bkcolor": "green" } }
      }
    },
    {
      "name": "EMA trend: NRSN 08:13 has the full lookback (5 and 10 bars back)",
      "fixture": "NRSN_20261125_1502",
      "until": "08:13",
      "run": ["TestEMATrendState"],
      "expect": {
        "vars": { "EMA_TREND_STATE": 1, "EMA9_BASE": 1.794, "EMA20_BASE": 1.36 },
        "buttons": { "CHART1.btn_ematrend": { "text": "EMA: UPTREND", "bkcolor": "green" } }
      }
    },
    {
      "name": "Candle range: NRSN 08:05, the $1.34 to $3.22 candle is far bigger than the 8 before (spike, red)",
      "fixture": "NRSN_20261125_1502",
      "until": "08:05",
      "run": ["TestExtended"],
      "vars": { "MPRICE": 2.01 },
      "expect": {
        "vars": { "SPIKEMULTIPLE": 34.1818, "SPIKEPCT": 93.5323, "RNG4PCT": 31.2189 },
        "buttons": { "CHART1.btn_range": { "text": "Rng4: $0.63 (31.2%) Spike: 34.2x", "bkcolor": "red" } }
      }
    },
    {
      "name": "Candle range: NRSN 08:08, right after the spike the 4-candle average is over 25% of price (red)",
      "fixture": "NRSN_20261125_1502",
      "until": "08:08",
      "run": ["TestExtended"],
      "vars": { "MPRICE": 2.44 },
      "expect": {
        "vars": { "SPIKEMULTIPLE": 1.745, "SPIKEPCT": 26.6393, "RNG4PCT": 34.6311 },
        "buttons": { "CHART1.btn_range": { "text": "Rng4: $0.85 (34.6%) Spike: 1.7x", "bkcolor": "red" } }
      }
    },
    {
      "name": "Candle range: NRSN 08:09 frontside, candles 17% of price but normal for the stock (orange warning, no block)",
      "fixture": "NRSN_20261125_1502",
      "until": "08:09",
      "run": ["TestExtended"],
      "vars": { "MPRICE": 2.87 },
      "expect": {
        "vars": { "SPIKEMULTIPLE": 1.0799, "SPIKEPCT": 17.0732, "RNG4PCT": 17.3345 },
        "buttons": { "CHART1.btn_range": { "text": "Rng4: $0.50 (17.3%) Spike: 1.1x", "bkcolor": "orange" } }
      }
    },
    {
      "name": "Candle range: NRSN 08:33, the flush candle is far bigger than the 8 before (spike, red)",
      "fixture": "NRSN_20261125_1502",
      "until": "08:33",
      "run": ["TestExtended"],
      "vars": { "MPRICE": 2.9 },
      "expect": {
        "vars": { "SPIKEMULTIPLE": 4.1366, "SPIKEPCT": 32.4138, "RNG4PCT": 14.6552 },
        "buttons": { "CHART1.btn_range": { "text": "Rng4: $0.42 (14.7%) Spike: 4.1x", "bkcolor": "red" } }
      }
    }
  ]
}
