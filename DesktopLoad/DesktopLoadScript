LoadVarFromFile("TradingRiskState");
Wait(2000);
$Chart1=GetWindowObj("Chart1");
$CurrentTradingDate=Substring($Chart1.GetBar(0).time,0,8);

$Account=GetAccountObj("MARGIN");
$Realized=($Account.curreq-$Account.openeq);

if($MarginTradingDate==$CurrentTradingDate){
    Speak "Trading risk state restored";
} else {
    Speak "New Trading day initialized";

    $MarginTradingDate=$CurrentTradingDate;
    $MarginPeakRealized=0;
    $TrainingPeakRealized=0;
    $TradingLockedOut=0;

    if($Realized<0){
        $TradingLockedOut=1;
    }

    SaveVarToFile("TradingRiskState");
}

if($TradingLockedOut==1){
    LockAllMontage;
}