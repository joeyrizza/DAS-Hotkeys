// Check for multiple losses
// Run every 1sec, and checks if the total realized loss has increased. If the loss counter reaches 2 or more, it locks all montages and prompts the user to take a break.

if (GetAccountObj($MONTAGE1.Account).Realized == $TEMPTOTAL)
{
    return;
}
else if (GetAccountObj($MONTAGE1.Account).Realized > $TEMPTOTAL)
{
    $TEMPTOTAL=GetAccountObj($MONTAGE1.Account).Realized;
    $Losses = 0;
}
else
{
    if ($MONTAGE1.Pos == 0)
    {
        $TEMPTOTAL=GetAccountObj($MONTAGE1.Account).Realized;
        $Losses=$Losses+1;

        if ($Losses >= 2)
        {
            $MONTAGE1.LockAllMontage Lock;
            Speak("You'd rather take a break!");
        }
    }
}