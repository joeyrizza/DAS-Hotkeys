$BuyPrice=Ask;
$MaxShares=200;
$MaximumRiskPerShare=.10;
$StartingRiskPercent=.50;
$MaxLongVal=2000;
$Route=LIMIT;
$Debug=0;

$StopLimitPriceOffset=.05;
$MinimumAllowedStopDistance=.05;

$MaximumAllowedDrawdownPercent=.50;

$MaximumRiskBudget=$MaxShares*$MaximumRiskPerShare;
$MinimumAllowedDrawdown=$MaximumRiskBudget*.75;
$MinimumPeakProfitForDrawdownProtection=$MaximumRiskBudget*.50;
$MinimumMaxShares=$MaxShares*.25;
$SelectedStopPrice=price;

$CurrentAccount=GetAccountObj(ACCOUNT);

if($CurrentAccount.Type == "Margin"){
    $Realized=($CurrentAccount.curreq-$CurrentAccount.openeq);
    $PeakRealized=$MarginPeakRealized;
    $TradingLockedOut=$MarginTradingLockedOut;
}

if($CurrentAccount.Type == "Margin(Demo)"){
    $Realized=($CurrentAccount.curreq-$CurrentAccount.openeq);
    $PeakRealized=$TrainingPeakRealized;
}

if($Realized > $PeakRealized){
    $PeakRealized=$Realized;
}

$DrawdownFromPeak=$PeakRealized-$Realized;
$AllowedDrawdown=$PeakRealized*$MaximumAllowedDrawdownPercent;

if($AllowedDrawdown < $MinimumAllowedDrawdown){
    $AllowedDrawdown=$MinimumAllowedDrawdown;
}

if($PeakRealized >= $MinimumPeakProfitForDrawdownProtection && $DrawdownFromPeak >= $AllowedDrawdown){
    $TradingLockedOut=1;
}

if($CurrentAccount.Type == "Margin" && $TradingLockedOut==1){
    $MarginPeakRealized=$PeakRealized;
    $MarginTradingLockedOut=$TradingLockedOut;
    SaveVarToFile("TradingRiskState");

    LockAllMontage;
    Speak "Daily drawdown limit reached";
    MsgBox(
        "TRADING LOCKED OUT"
        + "\nPeak Realized: $" + $PeakRealized
        + "\nCurrent Realized: $" + $Realized
        + "\nDrawdown From Peak: $" + $DrawdownFromPeak
        + "\nAllowed Drawdown: $" + $AllowedDrawdown
    );
    return;
}


if(Pos > 0){
    Speak "Position is not flat";
    return;
}
if($SelectedStopPrice >= Bid){
    Speak Stop is above Bid price;
    Price=$SelectedStopPrice;
    return;
}

if($BuyPrice-$SelectedStopPrice <= $MinimumAllowedStopDistance){
    Speak Stop is too close;
    Price=$SelectedStopPrice;
    return;
}

SwitchTWnd;
CXL ALLSYMB;

$ProfitThresholdToBeginScaling=($MaxShares*.5)*$MaximumRiskPerShare;
$ProfitThresholdForFullRisk=$ProfitThresholdToBeginScaling*5;

$RiskScalingPercent=($Realized-$ProfitThresholdToBeginScaling)/($ProfitThresholdForFullRisk-$ProfitThresholdToBeginScaling);

if($RiskScalingPercent < 0){$RiskScalingPercent=0;}
if($RiskScalingPercent > 1){$RiskScalingPercent=1;}

$DynamicMaxShares=Round($MinimumMaxShares+(($MaxShares-$MinimumMaxShares)*$RiskScalingPercent));

$TodaysRiskBudgetBasedOnRealized=$MaximumRiskBudget*($StartingRiskPercent+($RiskScalingPercent*(1-$StartingRiskPercent)));


$TechnicalStopDistance=$BuyPrice-$SelectedStopPrice;
$EffectiveRiskPerShare=$TechnicalStopDistance+$StopLimitPriceOffset;
if($EffectiveRiskPerShare <= 0){
    Speak Invalid risk calculation;
    return;
}
$RiskBasedShareCount=Round($TodaysRiskBudgetBasedOnRealized/$EffectiveRiskPerShare);

$FinalShareCount=MIN($RiskBasedShareCount,$DynamicMaxShares);

$CalculatedPositionValue=$BuyPrice*$FinalShareCount;
$MaxSharesAllowedByPositionValue=$MaxLongVal/$BuyPrice;

if($CalculatedPositionValue > $MaxLongVal){
    $FinalShareCount=$MaxSharesAllowedByPositionValue;
}

$ActualPosVal=$BuyPrice*$FinalShareCount;

$TechnicalStopRisk=$FinalShareCount*$TechnicalStopDistance;
$AdditionalOffsetRisk=$FinalShareCount*$StopLimitPriceOffset;
$WorstCasePlannedRisk=$FinalShareCount*$EffectiveRiskPerShare;

SShare=$amount;Share=$FinalShareCount;TogSShare;ROUTE=$Route;Price=$BuyPrice;TIF=DAY+;

if($Debug == 0){
  BUY=Send;
  TriggerOrder=RT:STOP STOPTYPE:LIMITP PX:$SelectedStopPrice-$StopLimitPriceOffset ACT:SELL STOPPRICE:$SelectedStopPrice QTY:Pos TIF:DAY+;
 } else {
    MsgBox(
    "Realized: $" + $Realized +
    "\nRisk Scaling: " + $RiskScalingPercent +
    "\nRisk Budget: $" + $TodaysRiskBudgetBasedOnRealized +
    "\nStop Distance: $" + $EffectiveRiskPerShare +
    "\nRisk-Based Shares: " + $RiskBasedShareCount +
    "\nDynamic Max Shares: " + $DynamicMaxShares +
    "\nFinal Shares: " + $FinalShareCount
);
 }
Price=$SelectedStopPrice;