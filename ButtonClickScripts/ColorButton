//Runs on: ColorButton click. Asks for a price and draws a yellow horizontal line there.

$p=input("Enter price for Horizontal Line");
$label="HL"+getsecond();
$color=color(255,255,0);
$lcolor=color(0,0,0);
$ct=$CHART1.getbar(0).Time;

if($p>0)
{
    $TL=$CHART1.CreateTrendline("HorizLine");
    $TL.name=$label + $CHART1.Symbol;
    $TL.Price=$p;
    $TL.text=$p;
    $TL.color=$color;
    $TL.time=$ct;
    $TL.time1=$ct;
    $TL.LabelTextColor=$lcolor;
    $TL.LabelBgColor=$color;
    $TL.LineStyle=0;
    $TL.LineWidth=1;
}