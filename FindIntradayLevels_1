$IDX=1;
$ct=$CHART1.getbar(0).Time;
$SEC=GetSecond();

if($SEC>=14400)
{
    $MAXBARS=($SEC-14400)/60;
}
else
{
    $MAXBARS=0;
}

// ============================================================
// CONFIGURATION
// ============================================================

$LowerPercent=20;
$UpperPercent=50;

$LowerPrice=$MPRICE*(1-($LowerPercent/100));
$UpperPrice=$MPRICE*(1+($UpperPercent/100));

// ============================================================
// TOP VOLUME CANDLE
// ============================================================

$V1=0;
$O1=0;
$H1=0;
$L1=0;
$C1=0;
$T1="";

// ============================================================
// SCAN BARS FROM 4:00 AM TO CURRENT TIME
// ============================================================

while($IDX<=$MAXBARS)
{
    $BAR=$CHART1.GetBar(-$IDX);
    $VOL=$BAR.Volume;

    if($VOL>$V1)
    {
        $V1=$VOL;
        $O1=$BAR.Open;
        $H1=$BAR.Hi;
        $L1=$BAR.Lo;
        $C1=$BAR.Close;
        $T1=$BAR.Time;
    }

    $IDX=$IDX+1;
}

// ============================================================
// CANDLE 1
// ============================================================

if($O1>=$LowerPrice && $O1<=$UpperPrice)
{
    $TL=$CHART1.CreateTrendline("HorizLine");
    $TL.Name="1O" + $CHART1.Symbol;
    $TL.Price=$O1;
    $TL.Color=Color(211,211,211);
    $TL.time=$ct;
    $TL.time1=$ct;
}

if($H1>=$LowerPrice && $H1<=$UpperPrice)
{
    $TL=$CHART1.CreateTrendline("HorizLine");
    $TL.Name="1H" + $CHART1.Symbol;
    $TL.Price=$H1;
    $TL.Color=Color(211,211,211);
    $TL.time=$ct;
    $TL.time1=$ct;
}

if($L1>=$LowerPrice && $L1<=$UpperPrice)
{
    $TL=$CHART1.CreateTrendline("HorizLine");
    $TL.Name="1L" + $CHART1.Symbol;
    $TL.Price=$L1;
    $TL.Color=Color(211,211,211);
    $TL.time=$ct;
    $TL.time1=$ct;
}

if($C1>=$LowerPrice && $C1<=$UpperPrice)
{
    $TL=$CHART1.CreateTrendline("HorizLine");
    $TL.Name="1C" + $CHART1.Symbol;
    $TL.Price=$C1;
    $TL.Color=Color(211,211,211);
    $TL.time=$ct;
    $TL.time1=$ct;
}

ConfigTrendLine Text SolidLine:FFFFFF:2;

