
// ============================================================
// CONFIGURATION
// ============================================================

$IDX=1;
$ct=$CHART1.getbar(0).Time;
$SEC=GetSecond();

if($SEC>=14400)
{
    $MAXBARS=($SEC-14400)/60;
}
else
{
    $MAXBARS=0;
}

$LowerPercent=20;
$UpperPercent=50;

$LowerPrice=$MPRICE*(1-($LowerPercent/100));
$UpperPrice=$MPRICE*(1+($UpperPercent/100));

// ============================================================
// TOP VOLUME CANDLE
// ============================================================

$V1=0;
$TopVolOpen=0;
$TopVolHigh=0;
$TopVolLow=0;
$TopVolClose=0;
$T1="";

// ============================================================
// SCAN BARS FROM 4:00 AM TO CURRENT TIME
// ============================================================

while($IDX<=$MAXBARS)
{
    $BAR=$CHART1.GetBar(-$IDX);
    $VOL=$BAR.Volume;

    if($VOL>$V1)
    {
        $V1=$VOL;
        $TopVolOpen=$BAR.Open;
        $TopVolHigh=$BAR.Hi;
        $TopVolLow=$BAR.Lo;
        $TopVolClose=$BAR.Close;
        $T1=$BAR.Time;
    }

    $IDX=$IDX+1;
}

// ============================================================
// CANDLE 1
// ============================================================

if($TopVolOpen>=$LowerPrice && $TopVolOpen<=$UpperPrice)
{
    $TL=$CHART1.CreateTrendline("HorizLine");
    $TL.Name="1O" + $CHART1.Symbol;
    $TL.Price=$TopVolOpen;
    $TL.Color=Color(211,211,211);
    $TL.time=$ct;
    $TL.time1=$ct;
    $TL.LabelTextColor=Color(0,0,0);
    $TL.LabelBgColor=Color(211,211,211);
}

if($TopVolHigh>=$LowerPrice && $TopVolHigh<=$UpperPrice)
{
    $TL=$CHART1.CreateTrendline("HorizLine");
    $TL.Name="1H" + $CHART1.Symbol;
    $TL.Price=$TopVolHigh;
    $TL.Color=Color(211,211,211);
    $TL.time=$ct;
    $TL.time1=$ct;
    $TL.LabelTextColor=Color(0,0,0);
    $TL.LabelBgColor=Color(211,211,211);
}

if($TopVolLow>=$LowerPrice && $TopVolLow<=$UpperPrice)
{
    $TL=$CHART1.CreateTrendline("HorizLine");
    $TL.Name="1L" + $CHART1.Symbol;
    $TL.Price=$TopVolLow;
    $TL.Color=Color(211,211,211);
    $TL.time=$ct;
    $TL.time1=$ct;
    $TL.LabelTextColor=Color(0,0,0);
    $TL.LabelBgColor=Color(211,211,211);
}

if($TopVolClose>=$LowerPrice && $TopVolClose<=$UpperPrice)
{
    $TL=$CHART1.CreateTrendline("HorizLine");
    $TL.Name="1C" + $CHART1.Symbol;
    $TL.Price=$TopVolClose;
    $TL.Color=Color(211,211,211);
    $TL.time=$ct;
    $TL.time1=$ct;
    $TL.LabelTextColor=Color(0,0,0);
    $TL.LabelBgColor=Color(211,211,211);
}

ConfigTrendLine Text SolidLine:FFFFFF:2;

