//Compares the Bid and Ask, gets the difference.
//Runs on: chartupdate.

$Spread=getquoteobj($CHART1.SYMBOL).Ask-getquoteobj($CHART1.SYMBOL).Bid;
$CHART1.GetCustButObj("btn_spread").text ="Spread: $" + Round($Spread,103);

if ($Spread < .05) {
    // < $0.05
  $CHART1.GetCustButObj("btn_spread").bkcolor=green;
}
else if ($Spread >= .05 && $Spread <= .10) {
    // $0.05 through $0.10
      $CHART1.GetCustButObj("btn_spread").bkcolor=orange;
}
else if ($Spread > .10) {
    // > $0.10
      $CHART1.GetCustButObj("btn_spread").bkcolor=red;
}