//Determines the vwap study from das and compares the current price to it.
//Runs on: chartupdate

$VWAP=$CHART1.GetStudyVal("StudyVWAP");
$ABOVEVWAP=0;
$VWAP_DISTANCE = $VWAP - $MPRICE;

if($MPRICE>$VWAP){
  $ABOVEVWAP=1;
  $CHART1.GetCustButObj("btn_vwap").text ="Above VWAP";
  $CHART1.GetCustButObj("btn_vwap").bkcolor=green;
} else {
  $CHART1.GetCustButObj("btn_vwap").text ="Below VWAP";
  $CHART1.GetCustButObj("btn_vwap").bkcolor=red;
}