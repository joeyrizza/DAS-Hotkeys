//get etb/htb/ssr status
$ETB=getquoteobj($CHART1.SYMBOL).ETB;
$SSR=getquoteobj($CHART1.SYMBOL).SSR;
$HTB=getquoteobj($CHART1.SYMBOL).HTB;

if($ETB == 1){
  $CHART1.GetCustButObj("btn_etb").text ="ETB";
  $CHART1.GetCustButObj("btn_etb").bkcolor=red;
}
if($HTB == 1 && SSR == 0){
  $CHART1.GetCustButObj("btn_etb").text ="Shortable: HTB";
  $CHART1.GetCustButObj("btn_etb").bkcolor=orange;
}
if($SSR == 1){
  $CHART1.GetCustButObj("btn_etb").text ="SSR";
  $CHART1.GetCustButObj("btn_etb").bkcolor=green;
}