// Interpret Short-Term Relative Volume + Price Change + Price Context

// Strong directional movement
if ($ST_RVOL10 >= 1.5 && $PriceChange > 0.25)
{
    $ST_Interpretation="Strong Buying";
}
else if ($ST_RVOL10 >= 1.5 && $PriceChange < -0.25)
{
    $ST_Interpretation="Strong Selling";
}

// High in recent range
else if ($PricePosition >= 75 && $ST_RVOL10 < 1.0 && $PriceChange >= -0.25 && $PriceChange <= 0.25)
{
    $ST_Interpretation="Consolidating High";
}
else if ($PricePosition >= 75 && $ST_RVOL10 < 1.0 && $PriceChange < -0.25)
{
    $ST_Interpretation="Pullback From High";
}

// Low in recent range
else if ($PricePosition <= 25 && $ST_RVOL10 < 1.0 && $PriceChange >= -0.25 && $PriceChange <= 0.25)
{
    $ST_Interpretation="Consolidating Low";
}
else if ($PricePosition <= 25 && $ST_RVOL10 < 1.0 && $PriceChange > 0.25)
{
    $ST_Interpretation="Bounce From Low";
}

// Low-volume directional movement
else if ($ST_RVOL10 < 1.0 && $PriceChange < -0.25)
{
    $ST_Interpretation="Quiet Pullback";
}
else if ($ST_RVOL10 < 1.0 && $PriceChange > 0.25)
{
    $ST_Interpretation="Weak Bounce";
}
else
{
    $ST_Interpretation="Neutral";
}

$CHART1.GetCustButObj("btn_st_interpret").text=$ST_Interpretation;