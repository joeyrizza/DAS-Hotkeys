
//Determines the short-term rvol based on the last 10 candles.
//Answers the question: How much participation is occurring right now?
//The forming bar's volume is projected to a full minute so the ratio
//doesn't depend on how far into the minute it is.
//Runs on: 1 sec

$ST_RVOL10=0;

//Refresh the 10-bar average on a new 1 min candle or a symbol change.
//Also retry while the average is 0 (bars may not have loaded yet after a switch).
if($STRVOL10TIME != $CURRENT_BAR_TIME || $STRVOL10SYMB != $CHART1.Symbol || $Avg10MinVol <= 0){
    $Vol1=$CHART1.GetBar(-1).Volume;
    $Vol2=$CHART1.GetBar(-2).Volume;
    $Vol3=$CHART1.GetBar(-3).Volume;
    $Vol4=$CHART1.GetBar(-4).Volume;
    $Vol5=$CHART1.GetBar(-5).Volume;
    $Vol6=$CHART1.GetBar(-6).Volume;
    $Vol7=$CHART1.GetBar(-7).Volume;
    $Vol8=$CHART1.GetBar(-8).Volume;
    $Vol9=$CHART1.GetBar(-9).Volume;
    $Vol10=$CHART1.GetBar(-10).Volume;

    $Avg10MinVol=($Vol1+$Vol2+$Vol3+$Vol4+$Vol5+$Vol6+$Vol7+$Vol8+$Vol9+$Vol10)/10;
    $Avg10MinVolK=$Avg10MinVol/1000;

    //Last finished bar vs. the average, used early in the new bar
    $ST_RVOL10_LAST=0;
    if($Avg10MinVol > 0){
        $ST_RVOL10_LAST=$Vol1/$Avg10MinVol;
    }
    $STRVOL10TIME = $CURRENT_BAR_TIME;
    $STRVOL10SYMB = $CHART1.Symbol;
}

$STRVOL_SEC=GetSecond() % 60;
$CurrentVol=$CHART1.GetBar(0).Volume;

if($Avg10MinVol > 0){
    if($STRVOL_SEC < 15){
        //Too little of the bar has traded to project: use the last finished bar
        $ST_RVOL10=$ST_RVOL10_LAST;
    } else {
        $ST_RVOL10=($CurrentVol*60/($STRVOL_SEC+1))/$Avg10MinVol;
    }
}
