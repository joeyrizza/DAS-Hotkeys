//This is a test script that is checking the short term relative volume over the last 10 minutes.
//Answers the question: How much participation is occuring right now?

$Vol1=$CHART1.GetBar(-1).Volume;
$Vol2=$CHART1.GetBar(-2).Volume;
$Vol3=$CHART1.GetBar(-3).Volume;
$Vol4=$CHART1.GetBar(-4).Volume;
$Vol5=$CHART1.GetBar(-5).Volume;
$Vol6=$CHART1.GetBar(-6).Volume;
$Vol7=$CHART1.GetBar(-7).Volume;
$Vol8=$CHART1.GetBar(-8).Volume;
$Vol9=$CHART1.GetBar(-9).Volume;
$Vol10=$CHART1.GetBar(-10).Volume;

$Avg10MinVol=($Vol1+$Vol2+$Vol3+$Vol4+$Vol5+$Vol6+$Vol7+$Vol8+$Vol9+$Vol10)/10;
$Avg10MinVolK=$Avg10MinVol/1000;

$CurrentVol=$CHART1.GetBar(0).Volume;
$ST_RVOL10=$CurrentVol/$Avg10MinVol;