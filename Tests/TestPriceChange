// Compares the last candle price compared to the previous 1-minute candle close.
// Answers the question: How much has the price moved during the current minute?
// Runs on: chartupdate

$PrevClose=$CHART1.GetBar(-1).Close;
$PriceChange=0;
if($PrevClose > 0){
    $PriceChange=(($MPRICE-$PrevClose)/$PrevClose)*100;
}
