// =========================================================
// MULTI-CANDLE PATTERNS
// =========================================================
$CANDLE_PATTERN="No Pattern";
$PATTERN_BIAS="Neutral";
// ---------------------------------------------------------
// Get current and previous candles
// ---------------------------------------------------------

$THEBAR0 = getwindowobj("CHART1").getbar(0);
$THEBAR1 = getwindowobj("CHART1").getbar(-1);
$THEBAR2 = getwindowobj("CHART1").getbar(-2);
$THEBAR3 = getwindowobj("CHART1").getbar(-3);
$THEBAR4 = getwindowobj("CHART1").getbar(-4);
$THEBAR5 = getwindowobj("CHART1").getbar(-5);
// =========================================================
// BULLISH IMPULSE
// =========================================================
//
// ONE-CANDLE IMPULSE:
//   - Bullish candle
//   - >= 3% price expansion
//   - >= 250K volume
//   - HH/HL structure NOT required
//
// MULTI-CANDLE IMPULSE:
//   - Meaningful cumulative price expansion
//   - Meaningful volume
//   - Bullish HH/HL structure
//
// THEBAR1 = most recent completed candle
// THEBAR2 = previous candle
// THEBAR3 = previous candle
// THEBAR4 = oldest candle
//
// =========================================================

$BULLISH_IMPULSE = 0;
$IMPULSE_TYPE = "NONE";

$MIN_IMPULSE_PERCENT = 3;
$MIN_IMPULSE_VOLUME = 250000;


// =========================================================
// ONE-CANDLE IMPULSE
// =========================================================
//
// A single large bullish candle can itself be an impulse.
//
// HH/HL structure does NOT apply here.
//
// =========================================================

$OneCandleMove = $THEBAR1.HI - $THEBAR1.OPEN;

$OneCandlePercent = 0;

if ($THEBAR1.OPEN > 0)
{
    $OneCandlePercent =
        ($OneCandleMove / $THEBAR1.OPEN) * 100;
}


// ---------------------------------------------------------
// TEST ONE-CANDLE CONDITIONS
// ---------------------------------------------------------

$OneCandleBullish = 0;
$OneCandleExpansion = 0;
$OneCandleVolume = 0;

if ($THEBAR1.CLOSE > $THEBAR1.OPEN)
{
    $OneCandleBullish = 1;
}

if ($OneCandlePercent >= $MIN_IMPULSE_PERCENT)
{
    $OneCandleExpansion = 1;
}

if ($THEBAR1.VOLUME >= $MIN_IMPULSE_VOLUME)
{
    $OneCandleVolume = 1;
}


// ---------------------------------------------------------
// ONE-CANDLE IMPULSE CONFIRMED
// ---------------------------------------------------------

if ($OneCandleBullish == 1)
{
    if ($OneCandleExpansion == 1)
    {
        if ($OneCandleVolume == 1)
        {
            $BULLISH_IMPULSE = 1;
            $IMPULSE_TYPE = "ONE-CANDLE";
        }
    }
}


// =========================================================
// MULTI-CANDLE IMPULSE
// =========================================================
//
// Only evaluate the multi-candle path if the most recent
// candle did NOT already qualify as a one-candle impulse.
//
// =========================================================

if ($BULLISH_IMPULSE == 0)
{

    // -----------------------------------------------------
    // FIND LOWEST LOW
    // -----------------------------------------------------

    $ImpulseLow = $THEBAR4.LO;

    if ($THEBAR3.LO < $ImpulseLow)
    {
        $ImpulseLow = $THEBAR3.LO;
    }

    if ($THEBAR2.LO < $ImpulseLow)
    {
        $ImpulseLow = $THEBAR2.LO;
    }

    if ($THEBAR1.LO < $ImpulseLow)
    {
        $ImpulseLow = $THEBAR1.LO;
    }


    // -----------------------------------------------------
    // FIND HIGHEST HIGH
    // -----------------------------------------------------

    $ImpulseHigh = $THEBAR1.HI;

    if ($THEBAR2.HI > $ImpulseHigh)
    {
        $ImpulseHigh = $THEBAR2.HI;
    }

    if ($THEBAR3.HI > $ImpulseHigh)
    {
        $ImpulseHigh = $THEBAR3.HI;
    }

    if ($THEBAR4.HI > $ImpulseHigh)
    {
        $ImpulseHigh = $THEBAR4.HI;
    }


    // -----------------------------------------------------
    // CALCULATE PRICE EXPANSION
    // -----------------------------------------------------

    $ImpulseMove =
        $ImpulseHigh - $ImpulseLow;

    $ImpulsePercent = 0;

    if ($ImpulseLow > 0)
    {
        $ImpulsePercent =
            ($ImpulseMove / $ImpulseLow) * 100;
    }


    // -----------------------------------------------------
    // TOTAL VOLUME
    // -----------------------------------------------------

    $ImpulseVolume =
        $THEBAR1.VOLUME +
        $THEBAR2.VOLUME +
        $THEBAR3.VOLUME +
        $THEBAR4.VOLUME;


    // -----------------------------------------------------
    // BULLISH STRUCTURE
    // -----------------------------------------------------

    $BullishStructure = 0;

    if ($THEBAR3.HI > $THEBAR4.HI)
    {
        if ($THEBAR2.HI > $THEBAR3.HI)
        {
            if ($THEBAR1.HI > $THEBAR2.HI)
            {
                if ($THEBAR3.LO >= $THEBAR4.LO)
                {
                    if ($THEBAR2.LO >= $THEBAR3.LO)
                    {
                        if ($THEBAR1.LO >= $THEBAR2.LO)
                        {
                            $BullishStructure = 1;
                        }
                    }
                }
            }
        }
    }


    // -----------------------------------------------------
    // MULTI-CANDLE IMPULSE CONFIRMED
    // -----------------------------------------------------

    if ($ImpulsePercent >= $MIN_IMPULSE_PERCENT)
    {
        if ($BullishStructure == 1)
        {
            if ($ImpulseVolume >= $MIN_IMPULSE_VOLUME)
            {
                $BULLISH_IMPULSE = 1;
                $CANDLE_PATTERN = "Bullish Impulse";
                $IMPULSE_TYPE = "MULTI-CANDLE";
            }
            else
            {
                $CANDLE_PATTERN = "Low Volume Impulse";
            }
        }
    }

}
// =========================================================
// THREE CANDLE REVERSAL
// =========================================================
//
// Detects a simple "the current candle has gone against the previous two candle pattern.
//
// =========================================================
$REVERSAL = 0;

if ($THEBAR1.LO < $THEBAR2.LO)
{
    if ($THEBAR0.LO >= $THEBAR1.LO)
    {
        if ($THEBAR0.HI > $THEBAR1.HI)
        {
            $REVERSAL = 1;
            $CANDLE_PATTERN = "Possible Reversal";
        }
    }
}
// =========================================================
// MULTI-CANDLE PATTERN BIAS
// =========================================================
//
// BULLISH = buying pressure / bullish reversal
// BEARISH = selling pressure / bearish reversal
// INDECISION = indecision / neutral
// =========================================================


if( $CANDLE_PATTERN == "Bullish Impulse")
{
    $PATTERN_BIAS = "BULLISH";
}
else if( $CANDLE_PATTERN == "Low Volume Impulse")
{
    $PATTERN_BIAS = "Indecision";
}

// =========================================================
// BUTTON TEXT
// =========================================================
$LADDER1.GetCustButObj("btn_pattern").text = $CANDLE_PATTERN;

// =========================================================
// BUTTON COLOR & SPEECH
// =========================================================

//$SECONDS_IN_MINUTE = getsecond() % 60;

if ("No Pattern" != $CANDLE_PATTERN)
{
    if(getvar("pattern_"+$CHART1.SYMBOL) != $THEBAR0.Time){
        speak($CANDLE_PATTERN);
        setvar("pattern_"+$CHART1.SYMBOL, $THEBAR0.Time);
    }
    if ($PATTERN_BIAS == "BULLISH")
    {
        $LADDER1.GetCustButObj("btn_pattern").bkcolor = green;
    }

    if ($PATTERN_BIAS == "BEARISH")
    {
        $LADDER1.GetCustButObj("btn_pattern").bkcolor = red;
    }

    if ($PATTERN_BIAS == "Indecision")
    {
        $LADDER1.GetCustButObj("btn_pattern").bkcolor = orange;
    }
}
else
{
    $LADDER1.GetCustButObj("btn_pattern").bkcolor = color(211,211,211);
}

