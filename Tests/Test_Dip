
// ============================================
// DIP ELIGIBILITY INDICATOR
// Runs on: ChartUpdate / 1-second interval
// Button: btn_dip
// ============================================


$DIPBTN=$LADDER1.GetCustButObj("btn_dip");

// ============================================
// CURRENT VALUES
// ============================================

$PRICE=$MONTAGE1.Last;
// SESSIONLOW, SESSIONHIGH and RETRACE50 are set by Test_Retracement (runs first)

// EMA / VWAP studies
$EMA9=GetStudyVal("Study9EMA");
$EMA20=GetStudyVal("Study20EMA");
$VWAP=GetStudyVal("StudyVWAP");

// Previous completed candles
$BAR1=$CHART1.GetBar(-1);
$BAR2=$CHART1.GetBar(-2);
$BAR3=$CHART1.GetBar(-3);

// ============================================
// Checks run from lowest to highest priority.
// The last condition that matches sets the reason,
// so blockers (below) override cautions.
// ============================================

$BLOCKED=0;
$CAUTION=0;

// ============================================
// CAUTION CONDITIONS
// ============================================

// Below 9 EMA while EMA alignment remains bullish
if($PRICE < $EMA9 && $EMA9 > $EMA20){
    $CAUTION=1;
    $DIPREASON="Bullish EMA";
    $DIPSPEECH="Dip Trade Caution, bullish moving average alignment.";
}

// Three consecutive lower highs and lower lows
if(
    $BAR1.HI < $BAR2.HI &&
    $BAR2.HI < $BAR3.HI &&
    $BAR1.LO < $BAR2.LO &&
    $BAR2.LO < $BAR3.LO
){
    $CAUTION=1;
    $DIPREASON="Lower Lows";
    $DIPSPEECH="Dip Trade Caution, lower highs and lows.";
}

// ============================================
// HARD INVALIDATORS
// ============================================

// Below VWAP
if($PRICE < $VWAP){
    $BLOCKED=1;
    $DIPREASON="Below VWAP";
    $DIPSPEECH="No dip, below veewap.";
}

// At or very near LOD
if($PRICE <= ($SESSIONLOW+0.01)){
    $BLOCKED=1;
    $DIPREASON="Near LOD";
    $DIPSPEECH="No dip, price is near low of day.";
}

// Below 50% of session's low-to-high move
if($PRICE < $RETRACE50){
    $BLOCKED=1;
    $DIPREASON="50% Retrace";
    $DIPSPEECH="No dip, price is below 50% retracement.";
}

// Bearish EMA alignment
if($EMA9 < $EMA20){
    $BLOCKED=1;
    $DIPREASON="Bearish EMA";
    $DIPSPEECH="No dip, bearish moving average alignment.";
}

// ============================================
// BUTTON DISPLAY
// ============================================

if($BLOCKED == 1){
    $DIPBTN.text="DIP: " + $DIPREASON;
    $DIPBTN.bkcolor=red;
}
else if($CAUTION == 1){
    $DIPBTN.text="DIP: " + $DIPREASON;
    $DIPBTN.bkcolor=orange;
}
else{
    $DIPBTN.text="DIP: OK";
    $DIPBTN.bkcolor=green;
    $DIPREASON="Dip Trade OK";
    $DIPSPEECH="Dip Trade OK.";
}

//Speeching the result
if ($DIPSPEECH != $DIPPREVIOUSREASON && $SpeakDipAction == 1){
    Speak($DIPSPEECH);
}
$DIPPREVIOUSREASON=$DIPSPEECH;
