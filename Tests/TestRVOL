//get the rvol value - 2wk

$AvgVolume2W = (
    $C1.Volume + $C2.Volume + $C3.Volume + $C4.Volume + $C5.Volume +
    $C6.Volume + $C7.Volume + $C8.Volume + $C9.Volume + $C10.Volume
) / 10;

$DASRVOL=getquoteobj($CHART1.SYMBOL).RVOL;
$RVOL=getquoteobj($CHART1.SYMBOL).Volume/$AvgVolume2W;
$RVOL=MAX($RVOL,$DASRVOL);
$CHART1.GetCustButObj("btn_rvol").text ="RVOL: " + $RVOL + "x";

if($RVOL>5){
  $CHART1.GetCustButObj("btn_rvol").bkcolor=green;
} else {
  if($RVOL == 0){
    $CHART1.GetCustButObj("btn_rvol").bkcolor=orange;
  } else {
    $CHART1.GetCustButObj("btn_rvol").bkcolor=red;
  }
}