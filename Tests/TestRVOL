//RVOL - Tests today's volume against the average daily volume over 10 days.
//Runs on: chartupdate

if($rvolsymbol != $CHART1.Symbol){
  $vol1 = $CHARTD.GetBar(-1).Volume;
  $vol2 = $CHARTD.GetBar(-2).Volume;
  $vol3 = $CHARTD.GetBar(-3).Volume;
  $vol4 = $CHARTD.GetBar(-4).Volume;
  $vol5 = $CHARTD.GetBar(-5).Volume;
  $vol6 = $CHARTD.GetBar(-6).Volume;
  $vol7 = $CHARTD.GetBar(-7).Volume;
  $vol8 = $CHARTD.GetBar(-8).Volume;
  $vol9 = $CHARTD.GetBar(-9).Volume;
  $vol10 = $CHARTD.GetBar(-10).Volume;
  $AvgVolume2W = (
      $vol1 + $vol2 + $vol3 + $vol4 + $vol5 +
      $vol6 + $vol7 + $vol8 + $vol9 + $vol10
  ) / 10;
  $rvolsymbol = $CHART1.SYMBOL;
}
// DAS's RVOL changes through the day, so read it every run
$DASRVOL=getquoteobj($CHART1.SYMBOL).RVOL;
// Reset every run so a symbol with no daily history (likely an IPO)
// never shows the previous symbol's RVOL.
$RVOL=0;
if($AvgVolume2W > 0){
  $RVOL=getquoteobj($CHART1.SYMBOL).Volume/$AvgVolume2W;
}

$RVOL=MAX($RVOL,$DASRVOL);
$CHART1.GetCustButObj("btn_rvol").text ="RVOL: " + Round($RVOL,1) + "x";

if($RVOL>5){
  $CHART1.GetCustButObj("btn_rvol").bkcolor=green;
} else {
  if($RVOL == 0){
    $CHART1.GetCustButObj("btn_rvol").bkcolor=orange;
  } else {
    $CHART1.GetCustButObj("btn_rvol").bkcolor=red;
  }
}