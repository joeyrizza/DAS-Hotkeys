//This script uses basically the same logic as DynamicEntry, but it uses different variables to not step on the toes of the original script. This allows for multiple entries to be calculated and sent at the same time.
//Runs on: 1 sec
//TODO: It's possible that drawing lines is expensive. may want to investiate


$TestPrice=$MONTAGE1.Ask;
$TestShareSize=25;
$TestMaxLongVal=2000;
$TestOffsetRisk=.05;
$TestMaximumRiskPerTrade=($TestShareSize*.15);
$TestTradeRisk=$TestMaximumRiskPerTrade;
$TestStopPrice=$MONTAGE1.price;
$ct=$CHART1.getbar(0).Time;

if(price <= 0){
    $CHART1.GetCustButObj("btn_riskpershare").text="Risk/Share: N/A";
    $CHART1.GetCustButObj("btn_shares").text="Shares: N/A";
    $CHART1.GetCustButObj("btn_plannedrisk").text="Risk: Price not Set";
    return;
}

$TechnicalStopDistance=$TestPrice-$TestStopPrice;
$TestRiskPerShare=Round($TechnicalStopDistance+$TestOffsetRisk,103);
$TestShareCount=Round($TestTradeRisk/$TestRiskPerShare);

if($TestShareCount > $TestShareSize){
    $TestShareCount=$TestShareSize;
}

$TestPositionValue=$TestPrice*$TestShareCount;
$TestShareSizeAllowedByPositionValue=$TestMaxLongVal/$TestPrice;

if($TestPositionValue > $TestMaxLongVal){
    $TestShareCount=$TestShareSizeAllowedByPositionValue;
}

if(shares <= 0){
    $CHART1.GetCustButObj("btn_riskpershare").text="Risk/Share: N/A";
    $CHART1.GetCustButObj("btn_shares").text="Shares: N/A";
    $CHART1.GetCustButObj("btn_plannedrisk").text="Risk: No Shares";
}

$TestPlannedRisk=$TestShareCount*$TestRiskPerShare;
$TestPlannedRiskR=$TestPlannedRisk/$TestMaximumRiskPerTrade;

$CHART1.GetCustButObj("btn_stop").text="Stop: " + $TestStopPrice + " (" + $TechnicalStopDistance + ")";
$CHART1.GetCustButObj("btn_riskpershare").text="Risk/Share: " + $TestRiskPerShare;
$CHART1.GetCustButObj("btn_shares").text="Shares: " + $TestShareCount;
$CHART1.GetCustButObj("btn_plannedrisk").text="Risk: " + Round($TestPlannedRiskR,2) + "R";

if($SETUPARMED == 1){
    $setuparmed=1;

    if (GetSecond() - $LAST_R_LINE_UPDATE >= 2)
    {
        //Draw profit lines
        $R1 = $MONTAGE1.Ask + $TechnicalStopDistance;
        $S1 = $TestStopPrice;

        if($R1 != $R1_Last){
            $L=$CHART1.GetTrendLine("R1");if (isobj($L)){$L.delete();}
            $TL=$CHART1.CreateTrendline("HorizLine");
            $TL.Name="R1";
            $TL.Price=$R1;
            $TL.Color=Color(0,200,0);
            $TL.LineStyle=2;
            $TL.LineWidth=2;
            $TL.time=$ct;
            $TL.time1=$ct;
            $TL.LabelTextColor=Color(0,0,0);;
            $TL.LabelBgColor=Color(0,200,0);
            GlobalTrendLineToLocal($TL);
            $R1_Last=$R1;
        }
        if($S1 != $S1_Last){
            $L=$CHART1.GetTrendLine("S1");if (isobj($L)){$L.delete();}
            $TL=$CHART1.CreateTrendline("HorizLine");
            $TL.Name="S1";
            $TL.Price=$S1;
            $TL.Color=Color(200,0,0);
            $TL.LineStyle=2;
            $TL.LineWidth=2;
            $TL.time=$ct;
            $TL.time1=$ct;
            $TL.LabelTextColor=Color(0,0,0);;
            $TL.LabelBgColor=Color(200,0,0);
            GlobalTrendLineToLocal($TL);
            $LAST_R_LINE_UPDATE = GetSecond();
            $S1_Last=$S1;
        }
        $LAST_R_LINE_UPDATE = GetSecond();
    }
    

}