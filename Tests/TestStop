//This script uses basically the same logic as DynamicEntry, but it uses different variables to not step on the toes of the original script. This allows for multiple entries to be calculated and sent at the same time.

$TestPrice=getquoteobj($CHART1.SYMBOL).Ask;
$TestShareSize=25;
$TestMaxLongVal=2000;
$TestOffsetRisk=.05;
$TestMaximumRiskPerTrade=($TestShareSize*.15);
$TestTradeRisk=$TestMaximumRiskPerTrade;
$TestStopPrice=$MONTAGE1.price;
$ct=$CHART1.getbar(0).Time;

if(price <= 0){
    $CHART1.GetCustButObj("btn_riskpershare").text="Risk/Share: N/A";
    $CHART1.GetCustButObj("btn_shares").text="Shares: N/A";
    $CHART1.GetCustButObj("btn_plannedrisk").text="Risk: Price not Set";
    return;
}

$TechnicalStopDistance=$TestPrice-$TestStopPrice;
$TestRiskPerShare=Round($TechnicalStopDistance+$TestOffsetRisk,103);
$TestShareCount=Round($TestTradeRisk/$TestRiskPerShare);

if($TestShareCount > $TestShareSize){
    $TestShareCount=$TestShareSize;
}

$TestPositionValue=$TestPrice*$TestShareCount;
$TestShareSizeAllowedByPositionValue=$TestMaxLongVal/$TestPrice;

