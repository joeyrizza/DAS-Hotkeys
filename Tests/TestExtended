//Test for Extended Candle
//Also does Avg Candle Size
//Runs: every 1 second

$EXTENDED=0;
$ExtensionWarningMultiplier=2;
$ExtensionMultiplier=4;

$EMA9=getstudyval("Study9EMA");

$bar0=$CHART1.GetBar(0);
$bar1=$CHART1.GetBar(-1);
$bar2=$CHART1.GetBar(-2);
$bar3=$CHART1.GetBar(-3);
$bar4=$CHART1.GetBar(-4);
$bar5=$CHART1.GetBar(-5);
$bar6=$CHART1.GetBar(-6);
$bar7=$CHART1.GetBar(-7);
$bar8=$CHART1.GetBar(-8);
$bar9=$CHART1.GetBar(-9);

$Range0=$bar0.Hi-$bar0.Lo;
$Range1=$bar1.Hi-$bar1.Lo;
$Range2=$bar2.Hi-$bar2.Lo;
$Range3=$bar3.Hi-$bar3.Lo;
$Range4=$bar4.Hi-$bar4.Lo;
$Range5=$bar5.Hi-$bar5.Lo;
$Range6=$bar6.Hi-$bar6.Lo;
$Range7=$bar7.Hi-$bar7.Lo;
$Range8=$bar8.Hi-$bar8.Lo;
$Range9=$bar9.Hi-$bar9.Lo;

$AverageRange10=(
    $Range0+
    $Range1+
    $Range2+
    $Range3+
    $Range4+
    $Range5+
    $Range6+
    $Range7+
    $Range8+
    $Range9
)/10;

$AverageRange4=(
    $Range0+
    $Range1+
    $Range2+
    $Range3
)/10;

$ExtensionAmount=$MPRICE-$EMA9;
$ExtensionPercent=0;
$ExtensionRangeMultiple=0;

if($EMA9>0){
    $ExtensionPercent=($ExtensionAmount/$EMA9)*100;
}

if($AverageRange10>0){
    $ExtensionRangeMultiple=$ExtensionAmount/$AverageRange10;
}

$ExtensionWarning=$EMA9+($AverageRange10*$ExtensionWarningMultiplier);
$Extension=$EMA9+($AverageRange10*$ExtensionMultiplier);

if($MPRICE<$ExtensionWarning){
    $CHART1.GetCustButObj("btn_extended").text=
        "9 Extension: "+
        Round($ExtensionRangeMultiple,2)+"x " + "($" + Round($ExtensionPercent,2) + ")";
    $CHART1.GetCustButObj("btn_extended").bkcolor=color(211,211,211);
} else if($MPRICE<$Extension){
    $CHART1.GetCustButObj("btn_extended").text=
        "9 Extension: "+
        Round($ExtensionRangeMultiple,2)+"x " + "($" + Round($ExtensionPercent,2) + ")";
    $CHART1.GetCustButObj("btn_extended").bkcolor=orange;
} else {
    $EXTENDED=1;
    $CHART1.GetCustButObj("btn_extended").text=
        "9 Extension: "+
        Round($ExtensionPercent,2)+"%"+
        " | "+Round($ExtensionRangeMultiple,2)+"x";
    $CHART1.GetCustButObj("btn_extended").bkcolor=red;
}

//Average Candle Size
$CHART1.GetCustButObj("btn_range").text ="Rng4: $" + Round($AverageRange4,103) + " Rng10: $" + Round($AverageRange10,103);
if($AverageRange4 > .3 || $AverageRange10 > .40){
  $CHART1.GetCustButObj("btn_range").bkcolor=red;
} else {
    if($AverageRange4 <= .3){
        $CHART1.GetCustButObj("btn_range").bkcolor=orange;
    } else{
        $CHART1.GetCustButObj("btn_range").bkcolor=color(211,211,211);
    }
}

//Risk Per Candle: TODO: make RPC button change rpcval val
$rpcval=25;
$rpc=25*Round($AverageRange10,103);
if($MPRICE <= 2){
  $rpc=$rpcval*Round($AverageRange10,4);
}

$CHART1.GetCustButObj("btn_risk").text ="Risk per candle: $" + $rpc;