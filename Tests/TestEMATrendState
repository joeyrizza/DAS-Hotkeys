// ============================================================
// EMA TREND CLASSIFICATION
//
// Classifies the 9 EMA and 20 EMA as:
//   UPTREND   = Both EMAs rising meaningfully
//   DOWNTREND = Both EMAs falling meaningfully
//   SIDEWAYS  = Everything else, including mixed directions
//
// Run on: New 1-minute candle
// Button: CHART1 - btn_ematrend
// ============================================================


// ============================================================
// CONFIGURATION
// Thresholds are percentage changes, not dollar amounts.
// These are starting values to test, not validated thresholds.
// ============================================================

$EMA_TREND_UP5 = 0.05;
$EMA_TREND_UP10 = 0.10;


// ============================================================
// RETRIEVE HISTORICAL EMA VALUES
//
// -1  = Most recent bar offset
// -6  = Five bars earlier
// -11 = Ten bars earlier
// ============================================================

$EMA9Info1 = $CHART1.GetStudyVal("Study9EMA", ByBarNum, -1);
$EMA9Info6 = $CHART1.GetStudyVal("Study9EMA", ByBarNum, -6);
$EMA9Info11 = $CHART1.GetStudyVal("Study9EMA", ByBarNum, -11);

$EMA20Info1 = $CHART1.GetStudyVal("Study20EMA", ByBarNum, -1);
$EMA20Info6 = $CHART1.GetStudyVal("Study20EMA", ByBarNum, -6);
$EMA20Info11 = $CHART1.GetStudyVal("Study20EMA", ByBarNum, -11);


// ============================================================
// EXTRACT NUMERIC EMA VALUES
// Example study string: "AVG:3.751"
// ============================================================

$EMA9_1 = Round(SubString($EMA9Info1, 5, StrLen($EMA9Info1)-1), 4);
$EMA9_6 = Round(SubString($EMA9Info6, 5, StrLen($EMA9Info6)-1), 4);
$EMA9_11 = Round(SubString($EMA9Info11, 5, StrLen($EMA9Info11)-1), 4);

$EMA20_1 = Round(SubString($EMA20Info1, 5, StrLen($EMA20Info1)-1), 4);
$EMA20_6 = Round(SubString($EMA20Info6, 5, StrLen($EMA20Info6)-1), 4);
$EMA20_11 = Round(SubString($EMA20Info11, 5, StrLen($EMA20Info11)-1), 4);


// ============================================================
// CALCULATE EMA PERCENTAGE CHANGES
// ============================================================

// 9 EMA: change over approximately 5 bars
$EMA9_CHANGE5 = (($EMA9_1 - $EMA9_6) / $EMA9_6) * 100;

// 9 EMA: change over approximately 10 bars
$EMA9_CHANGE10 = (($EMA9_1 - $EMA9_11) / $EMA9_11) * 100;

// 20 EMA: change over approximately 5 bars
$EMA20_CHANGE5 = (($EMA20_1 - $EMA20_6) / $EMA20_6) * 100;

// 20 EMA: change over approximately 10 bars
$EMA20_CHANGE10 = (($EMA20_1 - $EMA20_11) / $EMA20_11) * 100;


// ============================================================
// CLASSIFY EMA TREND
//
// 1 = UPTREND
// 2 = SIDEWAYS
// 3 = DOWNTREND
//
// Default to SIDEWAYS unless both averages confirm direction.
// ============================================================

$EMA_TREND_STATE = 2;

$CHART1.GetCustButObj("btn_ematrend").text = "EMA: SIDEWAYS";
$CHART1.GetCustButObj("btn_ematrend").bkcolor = orange;


// UPTREND: 9 EMA rising over 5 bars AND 20 EMA rising over 10 bars
if ($EMA9_CHANGE5 > $EMA_TREND_UP5 &&
    $EMA20_CHANGE10 > $EMA_TREND_UP10)
{
    $EMA_TREND_STATE = 1;

    $CHART1.GetCustButObj("btn_ematrend").text = "EMA: UPTREND";
    $CHART1.GetCustButObj("btn_ematrend").bkcolor = green;
}

// DOWNTREND: 9 EMA falling over 5 bars AND 20 EMA falling over 10 bars
else if ($EMA9_CHANGE5 < -$EMA_TREND_UP5 &&
         $EMA20_CHANGE10 < -$EMA_TREND_UP10)
{
    $EMA_TREND_STATE = 3;

    $CHART1.GetCustButObj("btn_ematrend").text = "EMA: DOWNTREND";
    $CHART1.GetCustButObj("btn_ematrend").bkcolor = red;
}