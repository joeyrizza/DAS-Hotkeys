
// ============================================================
// CLASSIFY EMA TREND WITH DETAILS
//
// 1 = UPTREND
// 2 = SIDEWAYS
// 3 = DETERIORATING
// 4 = MIXED
// ============================================================

$EMA_TREND_STATE = 4;

// ------------------------------------------------------------
// DESCRIBE INDIVIDUAL EMA DIRECTIONS
// ------------------------------------------------------------

$EMA9_DIRECTION = "FLAT";
$EMA20_DIRECTION = "FLAT";

if ($EMA9_CHANGE5 > $EMA_TREND_UP5)
{
    $EMA9_DIRECTION = "UP";
}
else if ($EMA9_CHANGE5 < -$EMA_TREND_UP5)
{
    $EMA9_DIRECTION = "DOWN";
}

if ($EMA20_CHANGE10 > $EMA_TREND_UP10)
{
    $EMA20_DIRECTION = "UP";
}
else if ($EMA20_CHANGE10 < -$EMA_TREND_UP10)
{
    $EMA20_DIRECTION = "DOWN";
}


// ------------------------------------------------------------
// DESCRIBE EMA SPREAD
// ------------------------------------------------------------

$EMA_SPREAD_DIRECTION = "STABLE";

if ($EMA_SPREAD_CHANGE < $EMA_SPREAD_CONTRACTION)
{
    $EMA_SPREAD_DIRECTION = "CONTRACTING";
}
else if ($EMA_SPREAD_CHANGE > 0.05)
{
    $EMA_SPREAD_DIRECTION = "EXPANDING";
}


