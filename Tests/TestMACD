//Interprets the MAVD study value from DAS.
//Runs on: new 1 minute candle and on symbol change.

$MACDInfo=$CHART1.GetStudyVal("StudyMACD",ByBarNum,0);
$CommaPos=StrFind($MACDInfo,", Signal:");
$MACDText=SubString($MACDInfo,5,$CommaPos);
$SignalText=SubString($MACDInfo,$CommaPos+9,StrLen($MACDInfo)-1);
$MACD=Round($MACDText,3);
$Signal=Round($SignalText,3);

// DAS's MACD reads exactly 0.000000 until it has enough bars from the
// start of the chart: about 26 for MACD and 34 for the signal line.
// Until both have a value, the comparison means nothing.
$MACDReady=1;
if($MACDText=="0.000000" || $SignalText=="0.000000")
{
  $MACDReady=0;
}

if($MACDReady==0)
{
  $CHART1.GetCustButObj("btn_macd").text ="MACD: No Data";
  $CHART1.GetCustButObj("btn_macd").bkcolor=color(211,211,211);
}
else if($MACD>$Signal)
{
  // MACD open / bullish
  //Speak("macdee is open");
  $CHART1.GetCustButObj("btn_macd").text ="MACD Pos";
  $CHART1.GetCustButObj("btn_macd").bkcolor=green;
}
else if($MACD<$Signal)
{
  // MACD closed / bearish
  //Speak("macdee is closed");
  $CHART1.GetCustButObj("btn_macd").text ="MACD Neg";
  $CHART1.GetCustButObj("btn_macd").bkcolor=red;
}
else
{
  // Equal to 3 decimals: crossing. SpeakTestResults doesn't warn either.
  $CHART1.GetCustButObj("btn_macd").text ="MACD Flat";
  $CHART1.GetCustButObj("btn_macd").bkcolor=color(211,211,211);
}

