// This is a test script that checks short-term price context.
// Current price compared to the high/low range of the previous 5 completed candles.
// Answers the question: Where is the current price relative to the recent move?
//Runs on: chartupdate

$High1=$CHART1.GetBar(-1).High;
$High2=$CHART1.GetBar(-2).High;
$High3=$CHART1.GetBar(-3).High;
$High4=$CHART1.GetBar(-4).High;
$High5=$CHART1.GetBar(-5).High;

$Low1=$CHART1.GetBar(-1).Low;
$Low2=$CHART1.GetBar(-2).Low;
$Low3=$CHART1.GetBar(-3).Low;
$Low4=$CHART1.GetBar(-4).Low;
$Low5=$CHART1.GetBar(-5).Low;

$RecentHigh=Max($High1,Max($High2,Max($High3,Max($High4,$High5))));
$RecentLow=Min($Low1,Min($Low2,Min($Low3,Min($Low4,$Low5))));

$Range=$RecentHigh-$RecentLow;
$PricePosition=(($MPRICE-$RecentLow)/$Range)*100;