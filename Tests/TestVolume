//Volume Test. Reads today's volume from the quote object.
//Runs on: <1M chartupdate, >1M 1 min
$VOL=getquoteobj($CHART1.SYMBOL).Volume;

if($VOL>=1000000)
{
    $VOLDISP=Round($VOL/1000000,1)+"M";
    $CHART1.GetCustButObj("btn_vol").bkcolor=green;
}
else if($VOL>=750000)
{
    $VOLDISP=Round($VOL/1000,1)+"K";
    $CHART1.GetCustButObj("btn_vol").bkcolor=orange;
}
else
{
    $CHART1.GetCustButObj("btn_vol").bkcolor=red;
    if($VOL>=1000)
    {
        $VOLDISP=Round($VOL/1000,1)+"K";
    }
    else
    {
        $VOLDISP=$VOL;
    }
}

$CHART1.GetCustButObj("btn_vol").text="Volume: " + $VOLDISP;