//get the yclose value
//Interprets gap from DAS value.
//Runs on: chartupdate
//TODO: Maybe add functionality to warn if price approaches certain % thresholds

if($gapsymbol != $CHART1.SYMBOL){
  $YCLOSE=getquoteobj($CHART1.SYMBOL).yClose; 
  $gapsymbol = $CHART1.SYMBOL;
}

// Reset every run so a symbol with no previous close (likely an IPO)
// never shows the previous symbol's gap.
$Gap=0;
$GAPPER=0;

if($YCLOSE > 0){
  $Gap=($MPRICE-$YCLOSE)/$YCLOSE*100;
  $GapPercent=Round($Gap);
  $CHART1.GetCustButObj("btn_gap").text ="Gap: " + $GapPercent + "%";

  if($Gap >= 10){
    $CHART1.GetCustButObj("btn_gap").bkcolor=green;
    $GAPPER=1;
  } else {
    $CHART1.GetCustButObj("btn_gap").bkcolor=red;
  }
} else {
  // No previous close: gap is unknown
  $CHART1.GetCustButObj("btn_gap").text ="Gap: N/A";
  $CHART1.GetCustButObj("btn_gap").bkcolor=orange;
}