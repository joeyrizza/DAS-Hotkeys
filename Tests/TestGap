//get the yclose value
$YCLOSE=getquoteobj($CHART1.SYMBOL).yClose;
$Gap=($MPRICE-$YCLOSE)/$YCLOSE*100;
$GapPercent=Round($Gap);
$Gapper=0;
$CHART1.GetCustButObj("btn_gap").text ="Gap: " + $GapPercent + "%";

if($Gap >= 10){
  $CHART1.GetCustButObj("btn_gap").bkcolor=green;
  $GAPPER=1;
  $PILLARS=$PILLARS+1;
} else {
  $CHART1.GetCustButObj("btn_gap").bkcolor=red;
}
