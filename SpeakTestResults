$OKtoArm=1;
//Non-Negotiables
//Price
if($MPRICE>20){
  Speak("Stock is too expensive."); $OKtoArm=0;
  return;
}
//Float
if($Float>20){
  Speak("Float too high."); $OKtoArm=0;
  return;
}
//Gap
if($GAP<=10){
  Speak("Gap less than 10%."); $OKtoArm=0;
  return;
}
//RVOL
if($RVOL>0 && $RVOL<=5){
  Speak("Relative Volume too low."); $OKtoArm=0;
  return;
}
//Average Range
if($AverageRange4 > .3 || $AverageRange10 > .40){
  Speak("Candle range too large."); $OKtoArm=0;
  return;
}
//Check for Very Large Candle Range
if($AverageRange10 > .40){
  Speak("Very large range."); 
  return;
}
//Volume
if($VOL < 750000){
  Speak("Volume too low. Wait for stock to become obvious."); $OKtoArm=0;
  return;
}
// Below VWAP: allow only when near VWAP, bullish, and buying participation is present
if($ABOVEVWAP != 1)
{
    if($VWAP_DISTANCE > $VWAP * 0.05 || $CANDLE_BIAS != BULLISH || $ST_RVOL10 > 1.0)
    {
        Speak("Below veewap - no confirmation");
        $OKtoArm=0;
        return;
    }
}

//Warnings
///////
//Price
if($MPRICE>10){
  Speak("Stock is expensive");
}
//VWAP
if($ABOVEVWAP==0){
Speak("Price is below veewap");
}
//MACD
if($MACD<$Signal){
Speak("Macdee is closed.");
}

 // 200 EMA / SMA proximity warning
if (
    ($MPRICE < $D200EMA && ($D200EMA - $MPRICE) <= $D200EMA * 0.05) ||
    ($MPRICE < $D200SMA && ($D200SMA - $MPRICE) <= $D200SMA * 0.05)
)
{
    Speak("Stock is under daily 200");
}

//Volume Check
//if($VOL < 1000000){
//  Speak("Low Volume.");
//}
//Easy to Borrow
if($ETB == 1){
  Speak("Stock is easy to borrow.");
}
//Check for Large Candle Range
if($AverageRange4 > .2){
  Speak("Candles have large range.");
}
//Check for Extended
if($Extended == 1){
  Speak("Stock may be extended.");
}
//Check Spread
if($Spread > .10){
  Speak("Stock has a wide spread.");
} else if($Spread > .05){
  Speak("Stock has a moderate spread.");
}
//Check Catalyst
$STATE=getvar("news_"+$CHART1.SYMBOL);
if($STATE==2) {
  Speak("Poor catalyst.");
}
if($STATE==3) {
  Speak("No catalyst to account for move.");
}
if($REVERSAL==0) {
  Speak("Price action has not yet confirmed a reversal.");
}
if($CHART1.GetTrendLine("1L" + $CHART1.Symbol) != 0){
  if($CHART1.GetTrendLine("1L" + $CHART1.Symbol).Price > $MPRICE){
    Speak("Price is below the highest volume candle.");
    return;
  } 
} 