
$IDX=1;
$ct=$CHART1.getbar(0).Time;
$SEC=GetSecond();

if($SEC>=14400)
{
    $MAXBARS=($SEC-14400)/60;
}
else
{
    $MAXBARS=0;
}

// ============================================================
// CONFIGURATION
// ============================================================

$LowerPercent=20;
$UpperPercent=50;

$LowerPrice=$MPRICE*(1-($LowerPercent/100));
$UpperPrice=$MPRICE*(1+($UpperPercent/100));

// ============================================================
// TOP VOLUME CANDLES
// ============================================================

$V1=0;
$TopVol1Open=0;
$TopVol1High=0;
$TopVol1Low=0;
$TopVol1Close=0;
$T1="";

$V2=0;
$TopVol2Open=0;
$TopVol2High=0;
$TopVol2Low=0;
$TopVol2Close=0;
$T2="";

// ============================================================
// SCAN BARS FROM 4:00 AM TO CURRENT TIME
// ============================================================

while($IDX<=$MAXBARS)
{
    $BAR=$CHART1.GetBar(-$IDX);
    $VOL=$BAR.Volume;

    if($VOL>$V1)
    {
        $V2=$V1;
        $TopVol2Open=$TopVol1Open;
        $TopVol2High=$TopVol1High;
        $TopVol2Low=$TopVol1Low;
        $TopVol2Close=$TopVol1Close;
        $T2=$T1;

        $V1=$VOL;
        $TopVol1Open=$BAR.Open;
        $TopVol1High=$BAR.Hi;
        $TopVol1Low=$BAR.Lo;
        $TopVol1Close=$BAR.Close;
        $T1=$BAR.Time;
    }
    else if($VOL>$V2)
    {
        $V2=$VOL;
        $TopVol2Open=$BAR.Open;
        $TopVol2High=$BAR.Hi;
        $TopVol2Low=$BAR.Lo;
        $TopVol2Close=$BAR.Close;
        $T2=$BAR.Time;
    }

    $IDX=$IDX+1;
}

// ============================================================
// CANDLE 1
// ============================================================

if($TopVol1Open>=$LowerPrice && $TopVol1Open<=$UpperPrice)
{
    $TL=$CHART1.CreateTrendline("HorizLine");
    $TL.Name="1O" + $CHART1.Symbol;
    $TL.Price=$TopVol1Open;
    $TL.Color=Color(211,211,211);
    $TL.time=$ct;
    $TL.time1=$ct;
    $TL.LabelTextColor=Color(0,0,0);
    $TL.LabelBgColor=Color(211,211,211);
