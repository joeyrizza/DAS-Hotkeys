$IDX=1;
$ct=$CHART1.getbar(0).Time;
$SEC=GetSecond();

if($SEC>=14400)
{
    $MAXBARS=($SEC-14400)/60;
}
else
{
    $MAXBARS=0;
}

// ============================================================
// CONFIGURATION
// ============================================================

$LowerPercent=20;
$UpperPercent=50;

$LowerPrice=$MPRICE*(1-($LowerPercent/100));
$UpperPrice=$MPRICE*(1+($UpperPercent/100));

// ============================================================
// TOP VOLUME CANDLES
// ============================================================

$V1=0;
$O1=0;
$H1=0;
$L1=0;
$C1=0;
$T1="";

$V2=0;
$O2=0;
$H2=0;
$L2=0;
$C2=0;
$T2="";

// ============================================================
// SCAN BARS FROM 4:00 AM TO CURRENT TIME
// ============================================================

while($IDX<=$MAXBARS)
{
    $BAR=$CHART1.GetBar(-$IDX);
    $VOL=$BAR.Volume;

    if($VOL>$V1)
    {
        $V2=$V1;
        $O2=$O1;
        $H2=$H1;
        $L2=$L1;
        $C2=$C1;
        $T2=$T1;

        $V1=$VOL;
        $O1=$BAR.Open;
        $H1=$BAR.Hi;
        $L1=$BAR.Lo;
        $C1=$BAR.Close;
        $T1=$BAR.Time;
    }
    else if($VOL>$V2)
    {
        $V2=$VOL;
        $O2=$BAR.Open;
        $H2=$BAR.Hi;
        $L2=$BAR.Lo;
        $C2=$BAR.Close;
        $T2=$BAR.Time;
    }

    $IDX=$IDX+1;
}

// ============================================================
// CANDLE 1
// ============================================================

if($O1>=$LowerPrice && $O1<=$UpperPrice)
{
    $TL=$CHART1.CreateTrendline("HorizLine");
    $TL.Name="1O" + $CHART1.Symbol;
    $TL.Price=$O1;
    $TL.Color=Color(211,211,211);
