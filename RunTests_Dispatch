//Run Tests Dispatch. deterines execution frequency of tests. Runs as 1sec task.
$MPRICE=getstudyval("StudyBar");

if($CHART1.Symbol==$selectedsymbol){
	//run every second
	exechotkey("RunTests_1sec");
	if($SetupArmed==1){
		$CHART1.GetCustButObj("btn_armed").text ="Setup Armed.";
		$CHART1.GetCustButObj("btn_armed").bkcolor=red;
	} else {
		$CHART1.GetCustButObj("btn_armed").text = getquoteobj($CHART1.SYMBOL).CompanyName + " | " +
		getquoteobj($CHART1.SYMBOL).Sector;
		$CHART1.GetCustButObj("btn_armed").bkcolor=color(211,211,211);    
	}
} else {
	//run on symbol change only.
	exechotkey("RunTests_Symb");
	$selectedsymbol=$CHART1.Symbol;
}

//Run only on new 1-min candle
$CURRENT_BAR_TIME = $CHART1.GetBar(0).Time;
if ($LAST_BAR != $CURRENT_BAR_TIME)
{
	exechotkey("RunTests_1min");
	$LAST_BAR = $CURRENT_BAR_TIME;
}
